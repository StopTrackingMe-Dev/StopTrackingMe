{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "builtin.netease-cloud-music.share-clean",
      "version": 3,
      "displayName": "网易云音乐",
      "source": {
        "kind": "BUILTIN",
        "reference": "assets/rules/netease-cloud-music.json"
      },
      "target": {
        "packageName": "com.netease.cloudmusic",
        "minVersionCode": null,
        "maxVersionCode": null
      },
      "shareTriggerSelectors": [
        {
          "resourceId": "shareView"
        }
      ],
      "sharePanelFingerprint": [
        {
          "textRegex": "^(分享(到|至)?|Share( to)?)$",
          "descriptionRegex": "^(分享(到|至)?|Share( to)?)$"
        },
        {
          "textRegex": "^(微信好友|WeChat)$",
          "descriptionRegex": "^(微信好友|WeChat)$"
        }
      ],
      "copyLinkScrollAnchorSelectors": [
        {
          "textRegex": "^(微信好友|WeChat)$",
          "descriptionRegex": "^(微信好友|WeChat)$"
        }
      ],
      "copyLinkSelectors": [
        {
          "textRegex": "^(复制链接|複製連結|Copy Link)$",
          "descriptionRegex": "^(复制链接|複製連結|Copy Link)$"
        }
      ],
      "maxClickableParentDepth": 5,
      "sharePanelTimeoutMs": 6000,
      "copySettleDelayMs": 800,
      "clipboardExtraction": {
        "urlRegex": "https?://[^\\s<>\"'，。！？；;（）()《》【】]+",
        "maxInputLength": 16384
      },
      "redirectPolicy": {
        "shortLinkHosts": [
          "163cn.tv"
        ],
        "allowedFinalHosts": [
          "music.163.com"
        ],
        "maxRedirects": 5,
        "requireHttps": true,
        "connectTimeoutMs": 5000,
        "readTimeoutMs": 5000
      },
      "sharePreview": {
        "titleSelectors": [
          { "type": "JSON_PATH", "key": "songs.0.name" }
        ],
        "descriptionSelectors": [
          { "type": "JSON_PATH", "key": "songs.0.artists.0.name" }
        ],
        "imageSelectors": [
          { "type": "JSON_PATH", "key": "songs.0.album.picUrl" }
        ],
        "imageAllowedHosts": ["126.net"],
        "pageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36"
        },
        "request": {
          "urlRegex": "^https://(?:y\\.)?music\\.163\\.com/m/song\\?id=([0-9]+).*$",
          "urlReplacement": "https://music.163.com/api/song/detail/?id=$1&ids=%5B$1%5D",
          "method": "GET",
          "headers": {
            "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36",
            "Accept": "application/json, text/plain, */*",
            "Referer": "https://music.163.com/"
          },
          "formParameters": {},
          "responseType": "JSON"
        },
        "imageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36",
          "Referer": "https://music.163.com/"
        }
      },
      "cleaningPolicy": {
        "removeExact": [
          "userid",
          "uid",
          "dlt",
          "uct2",
          "app_version",
          "h5_downloadvipgift",
          "playeruimodeid",
          "playerstyles_synchronoussharing",
          "shareuserid",
          "sharetoken",
          "from",
          "sc",
          "tn",
          "gclid",
          "fbclid",
          "msclkid",
          "mc_cid",
          "mc_eid"
        ],
        "removePrefixes": [
          "utm_",
          "fx-"
        ],
        "forceKeep": [
          "id"
        ]
      }
    }
  ]
}
