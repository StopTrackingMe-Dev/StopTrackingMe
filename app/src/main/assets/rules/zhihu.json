{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "builtin.zhihu.share-clean",
      "version": 3,
      "displayName": "知乎",
      "source": {
        "kind": "BUILTIN",
        "reference": "assets/rules/zhihu.json"
      },
      "target": {
        "packageName": "com.zhihu.android",
        "minVersionCode": null,
        "maxVersionCode": null
      },
      "shareTriggerSelectors": [
        {
          "descriptionRegex": "^(分享|Share)$",
          "clickable": true
        }
      ],
      "sharePanelFingerprint": [
        {
          "resourceId": "shareTitle",
          "textRegex": "^(分享|Share)$"
        },
        {
          "resourceId": "label",
          "textRegex": "^(复制链接|複製連結|Copy Link)$"
        }
      ],
      "copyLinkSelectors": [
        {
          "resourceId": "label",
          "textRegex": "^(复制链接|複製連結|Copy Link)$"
        }
      ],
      "maxClickableParentDepth": 3,
      "sharePanelTimeoutMs": 6000,
      "copySettleDelayMs": 800,
      "clipboardExtraction": {
        "urlRegex": "https?://[^\\s<>\"'，。！？；;（）()《》【】]+",
        "maxInputLength": 16384
      },
      "redirectPolicy": {
        "shortLinkHosts": [],
        "allowedFinalHosts": [
          "zhihu.com"
        ],
        "maxRedirects": 5,
        "requireHttps": true,
        "connectTimeoutMs": 5000,
        "readTimeoutMs": 5000
      },
      "sharePreview": {
        "titleSelectors": [
          { "type": "SCRIPT_JSON_PATH", "key": "js-initialData.initialState.entities.answers.*.question.title" },
          { "type": "SCRIPT_JSON_PATH", "key": "js-initialData.initialState.entities.questions.*.title" },
          { "type": "META_PROPERTY", "key": "og:title" },
          { "type": "META_NAME", "key": "twitter:title" },
          { "type": "HTML_TITLE" }
        ],
        "descriptionSelectors": [
          { "type": "SCRIPT_JSON_PATH", "key": "js-initialData.initialState.entities.answers.*.excerpt" },
          { "type": "META_PROPERTY", "key": "og:description" },
          { "type": "META_NAME", "key": "description" }
        ],
        "imageSelectors": [
          { "type": "META_PROPERTY", "key": "og:image" },
          { "type": "META_NAME", "key": "twitter:image" }
        ],
        "imageAllowedHosts": ["zhimg.com"],
        "pageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
          "Accept": "text/html,application/xhtml+xml;q=0.9",
          "Accept-Language": "zh-CN,zh;q=0.9"
        }
      },
      "cleaningPolicy": {
        "removeExact": [
          "share_code",
          "share_id",
          "share_source",
          "share_type",
          "invite_code",
          "gclid",
          "fbclid",
          "msclkid",
          "mc_cid",
          "mc_eid"
        ],
        "removePrefixes": [
          "utm_"
        ],
        "forceKeep": []
      }
    }
  ]
}
