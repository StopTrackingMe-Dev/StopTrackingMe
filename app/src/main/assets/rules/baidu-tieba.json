{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "builtin.baidu-tieba.share-clean",
      "version": 3,
      "displayName": "百度贴吧",
      "source": {
        "kind": "BUILTIN",
        "reference": "assets/rules/baidu-tieba.json"
      },
      "target": {
        "packageName": "com.baidu.tieba",
        "minVersionCode": null,
        "maxVersionCode": null
      },
      "shareTriggerSelectors": [
        {
          "resourceId": "obfuscated",
          "descriptionRegex": "^$",
          "className": "android.widget.ImageView",
          "clickable": true
        }
      ],
      "sharePanelFingerprint": [
        {
          "textRegex": "^(复制链接|複製連結|Copy Link)$",
          "className": "android.widget.TextView"
        },
        {
          "textRegex": "^(取消|Cancel)$",
          "className": "android.widget.TextView",
          "clickable": true
        }
      ],
      "copyLinkSelectors": [
        {
          "textRegex": "^(复制链接|複製連結|Copy Link)$",
          "className": "android.widget.TextView"
        }
      ],
      "maxClickableParentDepth": 1,
      "sharePanelTimeoutMs": 6000,
      "copySettleDelayMs": 800,
      "clipboardExtraction": {
        "urlRegex": "https?://[^\\s<>\"'，。！？；;（）()《》【】]+",
        "maxInputLength": 16384
      },
      "redirectPolicy": {
        "shortLinkHosts": [],
        "allowedFinalHosts": [
          "tieba.baidu.com",
          "c.tieba.baidu.com"
        ],
        "maxRedirects": 5,
        "requireHttps": true,
        "connectTimeoutMs": 5000,
        "readTimeoutMs": 5000
      },
      "sharePreview": {
        "titleSelectors": [
          { "type": "JSON_PATH", "key": "post_list.0.title" }
        ],
        "descriptionSelectors": [
          { "type": "JSON_PATH", "key": "post_list.0.content.0.text" },
          { "type": "JSON_PATH", "key": "forum.name" }
        ],
        "imageSelectors": [
          { "type": "JSON_PATH", "key": "post_list.0.content.0.origin_src" },
          { "type": "JSON_PATH", "key": "forum.avatar" }
        ],
        "imageAllowedHosts": ["baidu.com", "bdimg.com", "bdstatic.com", "bcebos.com"],
        "pageRequestHeaders": {
          "User-Agent": "bdtb for Android 12.80.1.0"
        },
        "request": {
          "urlRegex": "^https://tieba\\.baidu\\.com/p/([0-9]+).*$",
          "urlReplacement": "https://c.tieba.baidu.com/c/f/pb/page",
          "method": "POST",
          "headers": {
            "User-Agent": "bdtb for Android 12.80.1.0",
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "formParameters": {
            "_client_type": "2",
            "_client_version": "12.80.1.0",
            "kz": "$1",
            "pn": "1",
            "rn": "10"
          },
          "signature": {
            "algorithm": "MD5_CONCAT",
            "parameterName": "sign",
            "suffix": "tiebaclient!!!"
          },
          "responseType": "JSON"
        },
        "imageRequestHeaders": {
          "User-Agent": "bdtb for Android 12.80.1.0",
          "Referer": "https://tieba.baidu.com/"
        }
      },
      "cleaningPolicy": {
        "removeExact": [
          "share",
          "fr",
          "share_from",
          "share_source",
          "share_medium",
          "share_plat",
          "share_session_id",
          "share_tag",
          "share_id",
          "see_lz",
          "sfc",
          "client_type",
          "client_version",
          "st",
          "is_video",
          "unique",
          "gclid",
          "fbclid",
          "msclkid",
          "mc_cid",
          "mc_eid"
        ],
        "removePrefixes": [
          "utm_"
        ],
        "forceKeep": [
          "pn",
          "pid"
        ]
      }
    }
  ]
}
