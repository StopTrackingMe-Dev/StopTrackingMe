{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "builtin.weibo.share-clean",
      "version": 3,
      "displayName": "微博",
      "source": {
        "kind": "BUILTIN",
        "reference": "assets/rules/weibo.json"
      },
      "target": {
        "packageName": "com.sina.weibo",
        "minVersionCode": null,
        "maxVersionCode": null
      },
      "shareTriggerSelectors": [
        {
          "resourceId": "detail_activity_header_right_button",
          "descriptionRegex": "^(打开功能列表|更多|More( options)?)$",
          "clickable": true
        },
        {
          "resourceId": "right_button",
          "descriptionRegex": "^(打开功能列表|更多|More( options)?)$",
          "clickable": true
        }
      ],
      "sharePanelFingerprint": [
        {
          "resourceId": "tv_dialog_header_title",
          "textRegex": "^(分享|分享至|分享到|Share( to)?)$"
        },
        {
          "resourceId": "tv_dialog_item",
          "textRegex": "^(微信好友|朋友圈|生成长图|WeChat|Moments)$"
        }
      ],
      "copyLinkScrollAnchorSelectors": [
        {
          "resourceId": "tv_dialog_item",
          "textRegex": "^(生成长图|Generate Long Image)$"
        }
      ],
      "copyLinkSelectors": [
        {
          "resourceId": "tv_dialog_item",
          "textRegex": "^(复制链接|複製連結|Copy Link)$"
        }
      ],
      "maxClickableParentDepth": 5,
      "sharePanelTimeoutMs": 6000,
      "copySettleDelayMs": 800,
      "clipboardExtraction": {
        "urlRegex": "https?://[^\\s<>\"'，。！？；;（）()《》【】]+",
        "maxInputLength": 16384
      },
      "redirectPolicy": {
        "shortLinkHosts": [],
        "allowedFinalHosts": [
          "weibo.com",
          "weibo.cn",
          "passport.weibo.com"
        ],
        "maxRedirects": 5,
        "requireHttps": true,
        "connectTimeoutMs": 5000,
        "readTimeoutMs": 5000
      },
      "sharePreview": {
        "titleSelectors": [
          { "type": "JSON_PATH", "key": "text_raw" },
          { "type": "JSON_PATH", "key": "page_info.page_title" }
        ],
        "descriptionSelectors": [
          { "type": "JSON_PATH", "key": "user.screen_name" }
        ],
        "imageSelectors": [
          { "type": "JSON_PATH", "key": "page_info.page_pic" },
          { "type": "JSON_PATH", "key": "pics.0.large.url" }
        ],
        "imageAllowedHosts": ["sinaimg.cn"],
        "pageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36"
        },
        "request": {
          "urlRegex": "^https://weibo\\.com/[0-9]+/([0-9]+).*$",
          "urlReplacement": "https://weibo.com/ajax/statuses/show?id=$1",
          "method": "GET",
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
            "Accept": "application/json, text/plain, */*",
            "Referer": "https://weibo.com/"
          },
          "formParameters": {},
          "responseType": "JSON"
        },
        "bootstrap": {
          "tokenUrl": "https://passport.weibo.com/visitor/genvisitor",
          "tokenHeaders": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
            "Referer": "https://passport.weibo.com/visitor/visitor",
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "tokenFormParameters": { "cb": "gen_callback" },
          "tokenRegex": "\\\"tid\\\":\\\"([^\\\"]+)\\\"",
          "sessionUrlTemplate": "https://passport.weibo.com/visitor/visitor?a=incarnate&t={token}&w=3&c=100&gc=&cb=cross_domain&from=weibo",
          "sessionHeaders": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
            "Referer": "https://passport.weibo.com/visitor/visitor"
          }
        },
        "imageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36",
          "Referer": "https://weibo.com/"
        }
      },
      "cleaningPolicy": {
        "removeExact": [
          "refer_flag",
          "share_source",
          "share_from",
          "share_menu",
          "sourcetype",
          "jumpfrom",
          "featurecode",
          "luicode",
          "lfid",
          "sudaref",
          "gclid",
          "fbclid",
          "msclkid",
          "mc_cid",
          "mc_eid"
        ],
        "removePrefixes": [
          "utm_"
        ],
        "forceKeep": [
          "mid"
        ]
      }
    }
  ]
}
