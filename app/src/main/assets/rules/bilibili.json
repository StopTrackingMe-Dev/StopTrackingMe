{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "builtin.bilibili.share-clean",
      "version": 6,
      "displayName": "哔哩哔哩",
      "source": {
        "kind": "BUILTIN",
        "reference": "assets/rules/bilibili.json"
      },
      "target": {
        "packageName": "tv.danmaku.bili",
        "minVersionCode": null,
        "maxVersionCode": null
      },
      "shareTriggerSelectors": [
        {
          "resourceId": "frame_share"
        },
        {
          "resourceId": "share_icon"
        },
        {
          "textRegex": "^(分享|Share)$",
          "descriptionRegex": "^(分享|Share)$"
        }
      ],
      "sharePanelFingerprint": [
        {
          "textRegex": "^(分享(到|至)?|分享到|Share( to)?)$",
          "descriptionRegex": "^(分享(到|至)?|分享到|Share( to)?)$"
        },
        {
          "resourceId": "recycler",
          "className": "androidx.recyclerview.widget.RecyclerView"
        }
      ],
      "copyLinkScrollAnchorSelectors": [
        {
          "resourceId": "recycler",
          "className": "androidx.recyclerview.widget.RecyclerView"
        }
      ],
      "copyLinkSelectors": [
        {
          "textRegex": "^(复制链接|复制連結|Copy Link)$",
          "descriptionRegex": "^(复制链接|复制連結|Copy Link)$"
        }
      ],
      "copyTriggerMode": "USER_CONFIRMATION",
      "maxClickableParentDepth": 5,
      "sharePanelTimeoutMs": 5000,
      "copySettleDelayMs": 650,
      "clipboardExtraction": {
        "urlRegex": "https?://[^\\s<>\"'，。！？；;（）()《》【】]+",
        "maxInputLength": 16384
      },
      "redirectPolicy": {
        "shortLinkHosts": [
          "b23.tv"
        ],
        "allowedFinalHosts": [
          "bilibili.com",
          "bilibili.tv",
          "api.bilibili.com"
        ],
        "maxRedirects": 5,
        "requireHttps": true,
        "connectTimeoutMs": 5000,
        "readTimeoutMs": 5000
      },
      "sharePreview": {
        "titleSelectors": [
          { "type": "JSON_PATH", "key": "data.item.modules.module_dynamic.desc.text" },
          { "type": "JSON_PATH", "key": "data.item.modules.module_author.name" },
          { "type": "META_PROPERTY", "key": "og:title" },
          { "type": "META_NAME", "key": "twitter:title" },
          { "type": "HTML_TITLE" }
        ],
        "descriptionSelectors": [
          { "type": "JSON_PATH", "key": "data.item.modules.module_author.name" },
          { "type": "META_PROPERTY", "key": "og:description" },
          { "type": "META_NAME", "key": "description" }
        ],
        "imageSelectors": [
          { "type": "JSON_PATH", "key": "data.item.modules.module_dynamic.major.draw.items.0.src" },
          { "type": "JSON_PATH", "key": "data.item.modules.module_author.face" },
          { "type": "META_PROPERTY", "key": "og:image" },
          { "type": "META_NAME", "key": "twitter:image" }
        ],
        "imageAllowedHosts": ["hdslb.com", "biliimg.com"],
        "pageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36",
          "Accept": "text/html,application/xhtml+xml;q=0.9",
          "Referer": "https://www.bilibili.com/"
        },
        "request": {
          "urlRegex": "^https://www\\.bilibili\\.com/opus/([0-9]+).*$",
          "urlReplacement": "https://api.bilibili.com/x/polymer/web-dynamic/v1/detail?id=$1",
          "method": "GET",
          "headers": {
            "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36",
            "Accept": "application/json, text/plain, */*",
            "Referer": "https://www.bilibili.com/"
          },
          "formParameters": {},
          "responseType": "JSON"
        },
        "imageRequestHeaders": {
          "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/124.0 Mobile Safari/537.36",
          "Referer": "https://www.bilibili.com/"
        }
      },
      "cleaningPolicy": {
        "removeExact": [
          "spm_id_from",
          "from_spmid",
          "spmid",
          "vd_source",
          "share_source",
          "share_from",
          "share_medium",
          "share_plat",
          "share_session_id",
          "share_tag",
          "unique_k",
          "bbid",
          "buvid",
          "launch_id",
          "plat_id",
          "timestamp",
          "mid",
          "up_id",
          "-Arouter",
          "broadcast_type",
          "is_room_feed",
          "is_story_h5",
          "gclid",
          "fbclid",
          "msclkid",
          "mc_cid",
          "mc_eid"
        ],
        "removePrefixes": [
          "utm_"
        ],
        "forceKeep": [
          "p",
          "t"
        ]
      }
    }
  ]
}
